TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Without TYPESAFE_API_KEY, decisions use typesafe/jev-1.13 via OpenRouter
# (OPENROUTER_API_KEY, falling back to TEXT_MODEL_API_KEY).
OPENROUTER_API_KEY=
# Optional: drive a dedicated Chrome profile on this debug port; jev relaunches it if closed.
# BU_CDP_URL=http://127.0.0.1:9333
